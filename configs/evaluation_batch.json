      "id": "b1-restart-accidental-immediate",
      "map": "maps/evaluation/b1_three_lane_detours.json",
      "mode": "full-restart",
      "fault": "f-water-stage-1-offset"
    },
    {
      "id": "b1-restart-adversarial-immediate",
      "map": "maps/evaluation/b1_three_lane_detours.json",
      "mode": "full-restart",
      "fault": "a-fire-stage-1-decoy"
    },
    {
      "id": "b1-restart-irrelevant-immediate",
