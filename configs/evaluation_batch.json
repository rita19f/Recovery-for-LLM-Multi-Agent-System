{
  "name": "recovery-evaluation-v2-tritonai",
  "description": "Frozen held-out matrix over five basic (terminal-trap) and five extended (persistent HP, single-use weapons) maps. The restart baseline resets the agent workflow while preserving the physical environment at detection.",
  "expected_endpoint_host": "tritonai-api.ucsd.edu",
  "expected_model": "api-glm-5.3",
  "repetitions": 3,
  "defaults": {
    "planning_granularity": "chunk",
    "chunk_size": 3,
    "request_timeout": 180,
    "detection_delay_ticks": 0,
    "recovery_scope": "agent-only"
  },
  "runs": [
