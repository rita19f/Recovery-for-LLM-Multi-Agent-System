{
  "name": "stateful-recovery-development",
  "description": "Development-only recovery-scope checks for persistent health, weapons, and monsters. Both scopes fork from the same detection snapshot.",
  "expected_endpoint_host": "tritonai-api.ucsd.edu",
  "expected_model": "api-glm-5.3",
  "repetitions": 3,
  "defaults": {
    "planning_granularity": "chunk",
    "chunk_size": 3,
    "request_timeout": 180,
    "detection_delay_ticks": 0
  },
  "runs": [
    {
      "id": "stateful-clean",
      "map": "maps/development/stateful_weapon_crossing.json",
      "mode": "clean"
    },
    {
      "id": "stateful-accidental-after-harm",
      "map": "maps/development/stateful_weapon_crossing.json",
      "mode": "full-restart",
      "fault": "f-ice-sword-east-offset",
      "detection_trigger": "after-fault-caused-harm",
      "recovery_scope": "both"
    },
    {
      "id": "stateful-adversarial-after-harm",
      "map": "maps/development/stateful_weapon_crossing.json",
      "mode": "full-restart",
      "fault": "a-ice-sword-monster-decoy",
      "detection_trigger": "after-fault-caused-harm",
      "recovery_scope": "both"
    },
    {
      "id": "stateful-irrelevant",
      "map": "maps/development/stateful_weapon_crossing.json",
      "mode": "full-restart",
      "fault": "f-fire-sword-west-drop-once",
      "recovery_scope": "both"
    }
  ]
}
